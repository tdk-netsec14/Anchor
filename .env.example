# ---------------------------------------------------------------------------
# Anchor configuration. Copy to `.env` and edit. Never commit a real .env.
# Every value below is read by agent/config.py via pydantic-settings.
#
# This file is the complete list of settings. A test asserts that it stays in
# step with the code, so adding a setting without documenting it here fails CI.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
APP_NAME=anchor
APP_VERSION=0.2.0
# dev | test | prod. Setting this to `prod` turns on the startup checks at the
# bottom of this file; the process refuses to boot if production is not properly
# configured rather than starting insecurely.
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

# --- Authentication --------------------------------------------------------
# MUST be at least 16 characters (32 in production). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_ALGORITHM=HS256
# Access token lifetime. Also the window in which a member removed from a
# workspace could still act, because authorisation reads the signed claim.
# Shorter is safer; the refresh token is what keeps users signed in.
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=anchor

# --- Passwords -------------------------------------------------------------
# Argon2id parameters. The defaults are the RFC 9106 second-recommended
# profile. They are recorded in every hash, so raising them later re-hashes on
# each user's next login without invalidating anybody's password.
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=200
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2
# Server-side pepper, mixed into every password before hashing. Required in
# production: without it, a stolen hash table is attacked with Argon2 alone,
# and the pepper is a secret the attacker does not have. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every stored password.
CREDENTIAL_PEPPER=
# Set false on a deployment that provisions accounts by invitation only.
AUTH_ALLOW_REGISTRATION=true
# The development shortcut POST /auth/token (username + self-selected role, no
# password). It is refused outright when ENVIRONMENT=prod regardless of this
# value; setting it false also disables it in dev and test.
AUTH_ALLOW_DEMO_TOKENS=true
REFRESH_TOKEN_EXPIRY_DAYS=30
PASSWORD_RESET_EXPIRY_MINUTES=60
# The first account created on an empty database, so a fresh deployment has a
# way in. Applied once by `python -m agent.db.seed`, then ignored. Leave blank
# to disable self-service bootstrap and create the first user another way.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Database --------------------------------------------------------------
# REQUIRED in production. PostgreSQL for anything real; SQLite is supported for
# local development and the test suite.
#   Local:   postgresql://anchor:anchor@localhost:5432/anchor
#   Render:  postgresql://USER:PASSWORD@HOST/DBNAME  (from the dashboard)
# Run migrations with `alembic upgrade head` before starting the service.
# Left empty, the persistence-backed endpoints return 503 rather than guessing.
DATABASE_URL=
# Set true to have the seed script also create a demo workspace. Development only.
SEED_DEMO_WORKSPACE=false

# --- Object storage --------------------------------------------------------
# `local` writes under STORAGE_LOCAL_DIR and is the development default.
# `s3` is REQUIRED in production: a container filesystem is wiped on every
# deploy, so documents stored there would not survive one. S3, Cloudflare R2,
# Backblaze B2 and MinIO all work, since the driver speaks the S3 API.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/uploads
S3_BUCKET=
S3_REGION=us-east-1
# Leave blank for AWS. Set it for an S3-compatible endpoint (R2, MinIO, B2).
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prefix inside the bucket, so several environments can share one bucket.
S3_KEY_PREFIX=anchor

# --- Background worker -----------------------------------------------------
# How often the worker looks for pending ingestion jobs. It backs off when
# idle, so a low value costs nothing on an empty queue.
WORKER_POLL_SECONDS=2.0
# Attempts before an ingestion is marked FAILED. Transient failures (an object
# store blip, a timeout) are retried; a document that cannot be parsed is not.
WORKER_MAX_ATTEMPTS=3

# --- Rate limiting and quotas ----------------------------------------------
# NOTE: these counters live in process memory. Behind more than one API
# instance each keeps its own, so the effective ceiling is a multiple of the
# value below. They are a backstop against a runaway client, not a hard global
# limit; a true global limit needs shared state in front of the API.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Tighter budgets for the two expensive route classes: a question costs an LLM
# call, an upload costs OCR and embedding.
RATE_LIMIT_QUERY_REQUESTS=20
RATE_LIMIT_INGEST_REQUESTS=10
# Answered questions per workspace per day. 0 disables the check.
# Also per-process; see the note above.
QUOTA_QUERIES_PER_DAY=0

# --- Vector store / retrieval ---------------------------------------------
# PRODUCTION: ChromaDB persists to the LOCAL FILESYSTEM. On a platform with an
# ephemeral container filesystem (Render's default, most FaaS) this directory
# is wiped on every deploy and restart, and the knowledge base silently returns
# empty. Either mount a persistent disk and point this at it (see render.yaml,
# which uses /var/data), or move to a managed store before trusting a
# deployment. See the README section "Production data".
#
# Every chunk carries a workspace_id and every query filters on it, so tenants
# are isolated in the store itself rather than by filtering results afterwards.
CHROMA_PERSIST_DIR=chroma_data
CHROMA_COLLECTION=anchor_kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RETRIEVER_TOP_K=4

# --- Ingestion / OCR -------------------------------------------------------
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_CHARS_PER_PAGE=40
# Absolute path to the tesseract binary, for platforms where it is not on PATH
# (notably the Windows installer, which does not modify PATH). Leave blank to
# search PATH.
TESSERACT_CMD=
MAX_UPLOAD_MB=25

# --- Providers -------------------------------------------------------------
# Ollama is the only provider that works with zero credentials.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# Cloud providers are optional. Leave the key blank to mark them unavailable;
# the router then skips them during routing and fallback.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# --- Routing ---------------------------------------------------------------
ROUTER_DEFAULT_MODEL=ollama/llama3.2:3b
# Comma-separated provider ids tried in order when the primary selection fails.
ROUTER_FALLBACK_CHAIN=ollama,groq
ROUTER_MAX_TOOL_ITERATIONS=3

# --- Model execution -------------------------------------------------------
LLM_TIMEOUT_SECONDS=60.0
PROVIDER_MAX_RETRIES=1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Cost model ------------------------------------------------------------
# USD per 1M tokens, keyed by the full `provider/model` id the router reports
# (for example `groq/llama-3.3-70b-versatile`). No price is hardcoded, so a
# model left out of these maps reports a cost of 0.0 rather than a fabricated
# figure. JSON objects; leave blank to price nothing.
COST_INPUT_PER_MTOK=
COST_OUTPUT_PER_MTOK=

# --- Guardrails ------------------------------------------------------------
QUERY_MAX_CHARS=2000
TICKETS_DIR=data/tickets

# --- Browser access --------------------------------------------------------
# Origins allowed to call the API directly from a page. The Next.js frontend
# proxies through its own server, so production needs none of these: set this
# to an empty string to disable CORS entirely, which is the correct production
# posture (render.yaml does exactly that).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# ===========================================================================
# PRODUCTION CHECKLIST
#
# When ENVIRONMENT=prod, the service validates all of this at startup and
# refuses to boot rather than starting insecurely. Set every one of them.
#
#   [ ] DATABASE_URL            postgresql://...   (not SQLite)
#   [ ] STORAGE_BACKEND=s3      and S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY
#   [ ] CREDENTIAL_PEPPER       32+ random characters
#   [ ] JWT_SECRET              32+ characters
#   [ ] CORS_ALLOWED_ORIGINS    exact origins, or empty (the Vercel frontend
#                               proxies server-side and needs none)
#   [ ] AUTH_ALLOW_DEMO_TOKENS  irrelevant: /auth/token is disabled in prod
#       regardless, but leave it false for clarity
#   [ ] At least one of GROQ_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY, or an
#       OLLAMA_BASE_URL that is actually reachable
#   [ ] BOOTSTRAP_ADMIN_EMAIL + BOOTSTRAP_ADMIN_PASSWORD set for the first run,
#       then the password changed and the bootstrap values removed
#   [ ] CHROMA_PERSIST_DIR on a mounted persistent disk
# ===========================================================================
