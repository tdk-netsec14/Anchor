# ---------------------------------------------------------------------------
# Anchor configuration. Copy to `.env` and edit. Never commit a real .env.
# Every value below is read by agent/config.py via pydantic-settings.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
APP_NAME=anchor
APP_VERSION=0.1.0
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=true

# --- Authentication --------------------------------------------------------
# MUST be at least 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=anchor

# --- Vector store / retrieval ---------------------------------------------
CHROMA_PERSIST_DIR=chroma_data
CHROMA_COLLECTION=anchor_kb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RETRIEVER_TOP_K=4

# --- Ingestion / OCR -------------------------------------------------------
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_CHARS_PER_PAGE=40
# Absolute path to the tesseract binary, needed only where it is not on PATH
# (the Windows installer does not add itself):
#   TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
MAX_UPLOAD_MB=25

# --- Providers -------------------------------------------------------------
# Ollama is the only provider that works with zero credentials.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2:1b

# Cloud providers are optional. Leave the key blank to mark them unavailable;
# the router then skips them during routing and fallback.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# --- Routing ---------------------------------------------------------------
ROUTER_DEFAULT_MODEL=ollama/llama3.2:1b
# Comma-separated provider ids tried in order when the primary selection fails.
ROUTER_FALLBACK_CHAIN=ollama,groq
ROUTER_MAX_TOOL_ITERATIONS=3

# --- Model execution -------------------------------------------------------
LLM_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=400

# --- Guardrails ------------------------------------------------------------
QUERY_MAX_CHARS=2000
TICKETS_DIR=data/tickets

# --- Browser access --------------------------------------------------------
# Only needed to develop a UI on a different port; the bundled demo page at
# /ui is served same-origin and needs no CORS. Set to an empty value to
# disable CORS entirely, which is what a real deployment should do.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Cost reporting --------------------------------------------------------
# Empty by default, and no prices are hardcoded: estimated_cost_usd reports
# 0.0 rather than a fabricated figure. Add your contracted rates to make it
# meaningful. These are JSON objects keyed by "provider/model", exactly as
# reported in the model_used field. An empty value must be `{}`, not blank:
# a blank value is not valid JSON and will stop the service from starting.
COST_INPUT_PER_MTOK={}
COST_OUTPUT_PER_MTOK={}
# Example:
# COST_INPUT_PER_MTOK={"groq/llama-3.3-70b-versatile": 0.59}
# COST_OUTPUT_PER_MTOK={"groq/llama-3.3-70b-versatile": 0.79}
