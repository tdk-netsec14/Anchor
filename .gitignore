# --- Runtime data ----------------------------------------------------------
# Vector store contents are derived from data/documents and are rebuildable.
chroma_data/
.pytest_chroma/
.pytest_tickets/

# Ingestion outputs; the source documents themselves are tracked.
data/tickets/*.json
eval/results/*.json

# Uploaded documents when STORAGE_BACKEND=local. These are user content, not
# source — production uses S3, and nothing here should ever be committed.
data/uploads/

# --- Model weights ---------------------------------------------------------
models/

