# Anchor frontend configuration.
#
# Copy to `.env.local` for development; set the same variables in the Vercel
# project settings for production. Never commit a populated .env.local.

# Server-side URL of the FastAPI backend. Read only by Next.js route handlers,
# so it never reaches the browser bundle.
ANCHOR_API_URL=http://127.0.0.1:8000

# Public URL of the backend, used only to build the "API Docs" link. A
# deployment URL is public information; leave this unset in development and it
# falls back to the local address above.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
